  .services{background:#fff}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.service-card{min-height:248px;padding:25px 25px 22px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);transition:background .2s}.service-card:hover{background:#f8fbfc}.card-top{display:flex;justify-content:space-between;color:#168d88;font:11px 'DM Mono',monospace}.arrow{font-size:17px;color:#98a6b1}.service-card h3{font-size:18px;letter-spacing:-.03em;margin:27px 0 11px}.service-card p{font-size:12px;line-height:1.75;color:#667583;margin:0;min-height:63px}.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:15px}
