---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { services, technologies, engagementModels } from '../data/site';
---
<BaseLayout>
  <Header />
  <main>
    <section class="hero" id="inicio">
      <div class="wrap hero-grid">
        <div class="hero-copy"><div class="eyebrow"><span class="pulse"></span> INFRAESTRUTURA • REDES • SEGURANÇA</div><h1>Infraestrutura<br /><em>que funciona.</em></h1><p class="lead">Sustentação, troubleshooting, monitoramento, segurança e automação para ambientes de TI.</p><p class="support">Atuação técnica sob demanda para empresas que precisam de capacidade especializada sem necessariamente ampliar a equipe interna.</p><div class="actions"><a class="button button-primary" href="#contato">Solicitar conversa técnica <span>↗</span></a><a class="button button-quiet" href="#servicos">Conhecer serviços <span>↓</span></a></div><div class="proof"><div><b>20<span>+</span></b><small>anos de experiência<br />em tecnologia</small></div><i></i><div><b>Remota</b><small>atuação em ambientes<br />distribuídos</small></div><i></i><div><b>Flexível</b><small>sob demanda ou<br />recorrente</small></div></div></div>
        <div class="hero-art" aria-label="Diagrama de operação integrada de infraestrutura" role="img"><div class="art-top"><span>OPERAÇÃO INTEGRADA</span><span class="live"><b></b> DISPONÍVEL</span></div><div class="orbit orbit-1"></div><div class="orbit orbit-2"></div><div class="core"><div class="core-icon">M<span>.</span></div><strong>INFRA<br />ESTRUTURA</strong><small>visibilidade · controle · continuidade</small></div><div class="node n1"><span>01</span><b>COMPUTE</b><small>Linux · Windows</small></div><div class="node n2"><span>02</span><b>NETWORK</b><small>LAN · VPN · FW</small></div><div class="node n3"><span>03</span><b>OBSERVABILITY</b><small>Zabbix · Grafana</small></div><div class="node n4"><span>04</span><b>CLOUD</b><small>AWS · OCI</small></div><div class="connector c1"></div><div class="connector c2"></div><div class="connector c3"></div><div class="connector c4"></div><div class="art-foot"><span>STATUS DO AMBIENTE</span><span>04 CAMADAS MAPEADAS</span></div></div>
      </div><div class="hero-bottom"><div class="wrap"><span>CAPACIDADE TÉCNICA PARA OPERAÇÕES QUE NÃO PODEM PARAR</span><span class="scroll-cue">ROLE PARA EXPLORAR <b>↓</b></span></div></div>
    </section>

    <section class="section services" id="servicos"><div class="wrap"><div class="section-head"><div class="eyebrow">01 / SERVIÇOS</div><h2>Capacidade técnica onde<br />sua operação precisa.</h2><p>Apoio especializado para manter ambientes estáveis, investigar falhas e evoluir a operação com clareza e controle.</p></div><div class="service-grid">{services.map((service) => <article class="service-card"><div class="card-top"><span>{service.number}</span><span class="arrow">↗</span></div><h3>{service.title}</h3><p>{service.text}</p><div class="tags">{service.tags.map((tag) => <span class="tag">{tag}</span>)}</div></article>)}</div></div></section>

    <section class="section layers"><div class="wrap layers-grid"><div><div class="eyebrow">02 / MÉTODO</div><h2>Troubleshooting sem ficar preso a uma única camada.</h2><p>Problemas de infraestrutura raramente respeitam fronteiras entre tecnologias. Uma abordagem integrada conecta servidores, virtualização, redes, segurança e monitoramento para investigar o problema de ponta a ponta.</p><p>O objetivo não é apenas fazer voltar. É identificar evidências, reduzir recorrência e documentar a solução.</p><a class="text-link" href="#como-funciona">Conheça o processo <span>→</span></a></div><div class="stack" aria-label="Camadas avaliadas no troubleshooting"><div class="stack-head"><span>MAPA DE INVESTIGAÇÃO</span><span>END-TO-END</span></div>{['Aplicação','Sistema Operacional','Servidor / VM','Virtualização','Rede','Firewall / VPN','Cloud / Internet','Monitoramento'].map((item, i) => <div class="stack-row"><span class="stack-index">0{i + 1}</span><span>{item}</span><span class="stack-dot"></span></div>)}<div class="stack-foot"><span>ANÁLISE TRANSVERSAL</span><span>● EM CONTEXTO</span></div></div></div></section>

    <section class="section models"><div class="wrap"><div class="section-head"><div class="eyebrow">03 / MODELOS DE ATUAÇÃO</div><h2>Contratação alinhada<br />à necessidade.</h2><p>O formato é definido pelo contexto, escopo e nível de continuidade que sua equipe precisa.</p></div><div class="model-grid">{engagementModels.map(([title, text], i) => <article class="model-card"><span class="model-num">0{i + 1}</span><h3>{title}</h3><p>{text}</p><span class="model-arrow">↗</span></article>)}</div><div class="audience"><span class="eyebrow">PARA QUEM</span><div><span>Empresas</span><span>MSPs & NOCs</span><span>Integradores</span><span>Equipes internas de TI</span></div></div></div></section>

    <section class="section tech"><div class="wrap tech-grid"><div><div class="eyebrow">04 / TECNOLOGIAS</div><h2>Ferramentas a serviço<br />da operação.</h2><p>Experiência prática em infraestrutura e operação, com aprofundamento contínuo em automação, cloud e ferramentas associadas.</p><div class="tech-note"><span>i</span><p>A atuação considera o contexto de cada ambiente. Tecnologias em aprofundamento são aplicadas com escopo e expectativas alinhados.</p></div></div><div class="tech-list">{technologies.map((group, i) => <div class="tech-group"><div class="tech-label"><span>0{i + 1}</span>{group.name}</div><div class="tech-items">{group.items.map((item) => <span>{item}</span>)}</div></div>)}</div></div></section>

    <section class="section about" id="sobre"><div class="wrap about-grid"><div class="about-stamp"><div class="stamp-mark">M<span>.</span></div><div class="stamp-rule"></div><span>INFRAESTRUTURA<br />COM VISÃO PRÁTICA</span><div class="stamp-circles"><i></i><i></i><i></i></div></div><div class="about-copy"><div class="eyebrow">05 / SOBRE</div><h2>Experiência de infraestrutura com visão prática de operação.</h2><p>Profissional de Tecnologia com mais de 20 anos de experiência em infraestrutura, redes, servidores, virtualização, suporte técnico e segurança da informação.</p><p>A atuação é orientada à disponibilidade, troubleshooting, monitoramento, segurança, documentação e melhoria contínua.</p><p class="learning">Atualmente, há aprofundamento prático em cloud, automação, Infrastructure as Code e DevOps, com estudos e laboratórios em Ansible, Terraform, Docker, AWS e OCI.</p></div></div></section>

    <section class="section process" id="como-funciona"><div class="wrap"><div class="section-head"><div class="eyebrow">06 / COMO TRABALHO</div><h2>Do entendimento à validação.</h2><p>Um processo direto, com comunicação clara e registro do que foi feito.</p></div><div class="process-grid">{[['01','Entender','Compreender ambiente, problema e impacto.'],['02','Diagnosticar','Coletar evidências, analisar sintomas e identificar causa provável.'],['03','Executar','Aplicar solução de forma controlada e documentada.'],['04','Validar','Verificar resultado, registrar solução e identificar oportunidades de prevenção.']].map(([num,title,text])=><article><span>{num}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

    <section class="contact" id="contato"><div class="wrap contact-grid"><div class="contact-copy"><div class="eyebrow">07 / CONTATO</div><h2>Tem uma demanda<br />de infraestrutura?</h2><p>Envie um resumo do ambiente, problema ou projeto. A primeira conversa serve para entender o escopo e avaliar o modelo de atuação mais adequado.</p><div class="contact-aside"><span class="aside-icon">↗</span><span>Conversa inicial<br /><b>sem compromisso de escopo</b></span></div><div class="direct-contact"><a href="mailto:contato@mkdsdigital.com.br">contato@mkdsdigital.com.br</a><a href="tel:+5564999487995">+55 (64) 99948-7995</a><a href="https://wa.me/5564999487995" target="_blank" rel="noopener noreferrer">Conversar pelo WhatsApp ↗</a><a href="https://www.linkedin.com/in/marcelloleones" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div><form class="contact-form" id="contact-form"><div class="form-heading"><span>INICIAR CONVERSA</span><span>FORMULÁRIO</span></div><p>Ao enviar, seu aplicativo de e-mail será aberto com a solicitação preenchida.</p><div class="field-row"><label>Nome<input name="name" autocomplete="name" required /></label><label>Empresa<input name="company" autocomplete="organization" required /></label></div><div class="field-row"><label>Cargo<input name="role" autocomplete="organization-title" /></label><label>E-mail corporativo<input type="email" name="email" autocomplete="email" required /></label></div><div class="field-row"><label>WhatsApp <span class="optional">opcional</span><input name="phone" type="tel" autocomplete="tel" /></label><label>Tipo de necessidade<select name="need" required><option value="" disabled selected>Selecione uma opção</option><option>Infraestrutura</option><option>Redes</option><option>Segurança</option><option>Monitoramento</option><option>Cloud</option><option>Automação</option><option>Projeto</option><option>Sustentação recorrente</option><option>Outro</option></select></label></div><label>Mensagem<textarea name="message" rows="3" required placeholder="Ambiente, contexto e o que precisa resolver..."></textarea></label><div class="form-bottom"><button class="button button-primary" type="submit">Abrir e-mail para enviar <span>↗</span></button><span class="privacy">A mensagem será aberta no<br />seu aplicativo de e-mail.</span></div><div class="form-status" role="status" aria-live="polite"></div></form></div></section>
  </main>
  <footer class="footer"><div class="wrap"><div class="footer-top"><a class="brand" href="#inicio"><span class="brand-mark">M<span>.</span></span><span>MARCELLO<span class="brand-light">.infra</span></span></a><p>Infraestrutura · Redes · Segurança · Monitoramento · Automação · Cloud</p><a class="back-top" href="#inicio">VOLTAR AO TOPO ↑</a></div><div class="footer-bottom"><span>© 2026 Marcello Leones — Infraestrutura, Redes & Segurança</span><nav aria-label="Links do rodapé"><a href="#servicos">Serviços</a><a href="#como-funciona">Como funciona</a><a href="#sobre">Sobre</a><a href="#contato">Contato</a><a href="https://www.linkedin.com/in/marcelloleones" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></nav></div></div></footer>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const status = form.querySelector<HTMLElement>('.form-status');
    if (!form.reportValidity()) return;
    const values = new FormData(form);
    const body = [
      `Nome: ${values.get('name')}`,
      `Empresa: ${values.get('company')}`,
      `Cargo: ${values.get('role') || 'Não informado'}`,
      `E-mail: ${values.get('email')}`,
      `WhatsApp: ${values.get('phone') || 'Não informado'}`,
      `Necessidade: ${values.get('need')}`,
      '',
      `Mensagem: ${values.get('message')}`,
    ].join('\n');
    window.location.href = `mailto:contato@mkdsdigital.com.br?subject=${encodeURIComponent('Conversa técnica — MARCELLO.infra')}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .hero{position:relative;padding:81px 0 0;overflow:hidden;background:linear-gradient(115deg,#f8fafb 0%,#f2f6f8 100%)}.hero-grid{display:grid;grid-template-columns:1fr .93fr;gap:50px;align-items:center;min-height:570px;padding-bottom:72px}.hero-copy{padding:12px 0 0}.hero-copy .eyebrow{display:flex;align-items:center;gap:10px}.pulse{width:7px;height:7px;border-radius:50%;background:#20a399;box-shadow:0 0 0 4px rgba(32,163,153,.12)}h1{font-size:clamp(60px,7vw,88px);line-height:.99;letter-spacing:-.075em;margin:26px 0 24px;color:#10243a}h1 em{font-style:normal;color:#1c8e89}.lead{max-width:550px;font-weight:700;font-size:20px;line-height:1.5;letter-spacing:-.02em}.support{max-width:510px;color:#627181;font-size:14px;line-height:1.8;margin:12px 0 26px}.actions{display:flex;gap:11px;flex-wrap:wrap}.proof{display:flex;align-items:center;gap:22px;margin-top:49px}.proof div{display:flex;align-items:center;gap:9px}.proof b{font-size:19px;letter-spacing:-.04em;color:#10243a;white-space:nowrap}.proof b span{color:#168d88}.proof small{font-size:9px;line-height:1.4;color:#71808d}.proof i{height:30px;border-left:1px solid #d7e0e7}.hero-art{height:450px;position:relative;border:1px solid #dbe4e9;border-radius:8px;background:radial-gradient(ellipse at center,#fff 0%,#f7fafb 70%);box-shadow:0 24px 65px rgba(27,53,76,.08);overflow:hidden}.art-top,.art-foot{position:absolute;left:20px;right:20px;display:flex;justify-content:space-between;font:9px 'DM Mono',monospace;letter-spacing:.09em;color:#8a98a5}.art-top{top:19px}.live{color:#248e86}.live b{display:inline-block;width:6px;height:6px;border-radius:50%;background:#31aa93;margin-right:5px}.art-foot{bottom:18px;border-top:1px solid #e4eaee;padding-top:13px}.core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:182px;height:182px;border-radius:50%;background:#10243a;color:white;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;box-shadow:0 0 0 12px rgba(16,36,58,.04),